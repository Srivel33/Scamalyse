{
  "manifest_version": 3,
  "name": "Scamalyse Shield",
  "version": "1.0",
  "description": "Scan highlighted job postings and emails for scams instantly using the Scamalyse Risk Engine.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scan with Scamalyse"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
