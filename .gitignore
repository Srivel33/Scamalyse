# ============================================================
#  Scamalyse — Project .gitignore
#  Python FastAPI Backend  +  React / Vite Frontend  +  Chrome Extension
# ============================================================


# ────────────────────────────────────────────────────────────
#  ENVIRONMENT & SECRETS  (never commit these)
# ────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ────────────────────────────────────────────────────────────
#  BACKEND — Python
# ────────────────────────────────────────────────────────────

# Virtual environment
backend/venv/
backend/.venv/
venv/
.venv/

# Compiled Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Build artefacts
*.egg-info/
*.egg

# Testing & coverage
backend/.pytest_cache/
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Type checker caches
.mypy_cache/
.pyright/

# Local SQLite database (generated at runtime — do not commit)
*.db
*.sqlite
*.sqlite3

# ────────────────────────────────────────────────────────────
#  FRONTEND — Node / React / Vite
# ────────────────────────────────────────────────────────────

# Dependencies (always re-installed with npm install)
frontend/node_modules/
node_modules/

# Production build output (generated by npm run build)
frontend/dist/
dist/

# Vite internal cache
.vite/
frontend/.vite/

# ────────────────────────────────────────────────────────────
#  CHROME EXTENSION
#  Source files are tracked. Only generated package artifacts ignored.
# ────────────────────────────────────────────────────────────
*.crx
*.zip

# ────────────────────────────────────────────────────────────
#  EDITOR & OS NOISE
# ────────────────────────────────────────────────────────────

# VS Code
.vscode/

# JetBrains IDEs
.idea/

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

# ────────────────────────────────────────────────────────────
#  LOGS & MISC
# ────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-error.log*

# Documentation build output
docs/_build/
docs/site/